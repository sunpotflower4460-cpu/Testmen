default_platform(:ios)

platform :ios do
  desc "ストア情報(説明文・スクショ)をアップロード"
  lane :upload_metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      run_precheck_before_submit: false,
      languages: ["ja"]
    )
  end

  desc "品質確認・提出前検査・ビルドを行い App Store Connect へアップロード"
  lane :release do
    sh("cd .. && npm run check && npm run validate:appstore && npx cap sync ios")
    build_app(
      project: "App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store"
    )
    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      languages: ["ja"]
    )
  end
end
