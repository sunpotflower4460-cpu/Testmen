default_platform(:ios)

platform :ios do
  # メタデータとスクリーンショットだけを App Store Connect にアップロード（バイナリなし）
  # 事前に App Store Connect でアプリ(Bundle ID)を作成しておいてください。
  desc "ストア情報(説明文・スクショ)をアップロード"
  lane :upload_metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,             # プレビュー確認をスキップ
      run_precheck_before_submit: false,
      languages: ["ja"]
    )
  end

  # ビルド → アップロード（要: 署名設定済み・実機/CI）
  desc "ビルドして App Store Connect へアップロード"
  lane :release do
    # Webビルドを同期
    sh("cd .. && npm run build && npx cap sync ios")
    build_app(
      project: "App/App.xcodeproj", # SPMのためworkspaceではなくproject
      scheme: "App",
      export_method: "app-store"
    )
    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: false,
      overwrite_screenshots: true,
      force: true,
      languages: ["ja"]
    )
  end
end
